# ============================================================
# Server Configuration
# ============================================================
HOST=0.0.0.0
PORT=4000
DEBUG=False

# ============================================================
# 100% Free AI Engine Configuration
# ============================================================
# Options:
# - local_ai : 100% Free, Offline, Zero API keys, Zero cost (Default)
# - gemini   : Google AI Studio 100% Free Tier (requires free key from aistudio.google.com)
# - groq     : Groq Cloud 100% Free Tier (requires free key from console.groq.com)
LLM_PROVIDER=local_ai

# Optional Free Tier API Keys (only needed if LLM_PROVIDER is switched from local_ai)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================
# Automated Multi-Platform Posting Configuration
# ============================================================
# Set POSTING_SIMULATION_MODE=true for instant testing with zero credentials.
# Set POSTING_SIMULATION_MODE=false to test live delivery with your free platform keys.
POSTING_SIMULATION_MODE=true

# 1. Telegram Bot Integration (100% Free: create via @BotFather in 1 min)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Discord Webhook Integration (100% Free: create in Channel Settings -> Integrations)
DISCORD_WEBHOOK_URL=

# 3. Slack Webhook Integration (100% Free: add Incoming Webhook in Slack Apps)
SLACK_WEBHOOK_URL=

# 4. Mastodon Integration (100% Free & Open Source)
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 5. Bluesky Integration (100% Free: generate App Password in Settings)
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# 6. X (Twitter) API v2 Integration (Optional)
TWITTER_BEARER_TOKEN=
